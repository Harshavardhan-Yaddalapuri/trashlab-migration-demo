# Server-side only. Never import these into client components.
# Copy to .env.local for local development.

# Postgres (Neon/Supabase free tier)
DATABASE_URL=postgres://user:password@host:5432/trashlab

# LangSmith tracing + eval (optional locally, required for eval gate)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trashlab-migration-cockpit

# LLM provider for judgment paths (server-side only)
OPENAI_API_KEY=

# Redis for BullMQ (optional; falls back to Postgres LISTEN/NOTIFY)
REDIS_URL=redis://localhost:6379
