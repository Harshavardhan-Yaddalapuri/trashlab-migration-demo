# Server-side only. Never import these into client components.
# Copy to .env.local for local development.

# Postgres (Neon serverless Postgres). Use the pooled connection string
# (hostname ends in "-pooler") -- serverless functions open many short-lived
# connections and a direct connection can't handle that concurrency well.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Vercel Blob storage. Uploaded source files go straight from the browser to
# Blob storage (bypassing the platform's request body size limit), so this
# is required for the upload flow to work at all.
BLOB_READ_WRITE_TOKEN=

# LangSmith tracing (optional). Adds real overhead at 150k-record scale, so
# it's usually left off outside of active debugging.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trashlab-migration-cockpit
